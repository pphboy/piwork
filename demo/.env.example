# Copy to .env and fill in. The daemon loads .env at startup; every value is
# optional and falls back to the ambient environment.

# --- credentials -------------------------------------------------------------
# pi reads these two itself and never from the code below. ANTHROPIC_AUTH_TOKEN
# is sent as "Authorization: Bearer", which is what token-based proxies expect.
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# Used only when the variable above is absent. Setting a plain key makes pi send
# the x-api-key header instead of a bearer token.
# ANTHROPIC_API_KEY=
# PIWORK_API_KEY=
# PIWORK_PROVIDER=anthropic

# --- daemon ------------------------------------------------------------------
# PIWORK_HOST=127.0.0.1
# PIWORK_PORT=8083

# Model to use. Empty means "first model that has working credentials".
# PIWORK_MODEL=anthropic/claude-opus-4-5:high

# Tools the agent may use. Default: read,bash,edit,find,ls (see README for what
# that means - there is no approval step). Use an empty value or "none" for a
# pure Q&A agent that cannot touch the filesystem.
# PIWORK_TOOLS=read,find,ls

# PIWORK_AGENT_DIR=.piwork/agent
# PIWORK_WORKSPACE=.piwork/workspaces/default
# PIWORK_LOG_LEVEL=info
