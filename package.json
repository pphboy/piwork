{
  "name": "piwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "config": {
    "protocVersion": "36.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "npm run clean --workspaces --if-present",
    "typecheck": "npm run typecheck -w @piwork/contracts -w @piwork/pi-package -w @piwork/work-store -w @piwork/pi-adapter -w @piwork/agentd -w @piwork/desktop-webui -w @piwork/console-webui",
    "build": "make build",
    "test": "make test",
    "test:integration": "make test-integration",
    "serve": "./dist/go/piwork-serve",
    "console": "./dist/go/piwork-console",
    "cli": "./dist/go/piwork-cli",
    "agent:image": "make native-agent-images",
    "file-helper:image": "make native-helper-images",
    "acceptance": "make acceptance",
    "release": "make release"
  },
  "devDependencies": {
    "@protobuf-ts/protoc": "2.11.1",
    "@types/node": "24.13.6",
    "ts-proto": "2.12.4",
    "typescript": "7.0.2"
  }
}
