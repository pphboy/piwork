{
  "name": "@piwork/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "piwork-console": "dist/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && node scripts/copy-static.mjs",
    "test:unit": "npm run build && node --test dist/**/*.test.js",
    "test:browser": "npm run build && playwright test"
  },
  "dependencies": {
    "@piwork/client-sdk": "^0.1.0",
    "@piwork/contracts": "^0.1.0",
    "@piwork/pi-package": "^0.1.0",
    "@types/busboy": "^1.5.4",
    "busboy": "^1.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1"
  }
}
