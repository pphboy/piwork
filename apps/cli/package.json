{
  "name": "@piwork/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@piwork/client-sdk": "0.1.0"
  },
  "bin": {
    "piwork": "dist/main.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test:unit": "npm run build && node --test dist/**/*.test.js"
  }
}
