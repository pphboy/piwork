{
  "name": "@piwork/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@piwork/client-sdk": "0.1.0",
    "@piwork/contracts": "0.1.0",
    "@piwork/pi-package": "0.1.0",
    "@piwork/work-package": "0.1.0",
    "busboy": "^1.6.0",
    "saxes": "6.0.0",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/busboy": "^1.5.4"
  },
  "bin": {
    "piwork-cli": "dist/main.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && node scripts/copy-static.mjs",
    "test:unit": "npm run build && node --test dist/*.test.js dist/**/*.test.js"
  }
}
