{
  "name": "@piwork/console-webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs && node ../../scripts/sync-console-assets.mjs",
    "test:browser": "playwright test -c playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1"
  }
}
