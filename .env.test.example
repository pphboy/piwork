# Copy to a private file, replace CHANGE_ME values, and pass it to
# piwork-serve serve --env-file. Use a fresh Go data directory.

# Normal serve commands may set PIWORK_LISTEN and PIWORK_CORE_URL. The
# listener is configured separately with --listen.

PIWORK_ADMIN_ACCOUNT=admin
PIWORK_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARACTERS

PIWORK_AGENT_IMAGE=piwork-agentd:go-migration-production
PIWORK_PACKAGE_HELPER_IMAGE=piwork-agentd:go-migration-production
PIWORK_FILE_HELPER_IMAGE=piwork-file-helper:go-migration-acceptance
PIWORK_SNAPSHOT_HELPER_IMAGE=piwork-snapshot-helper:go-migration-acceptance
PIWORK_MODEL_PROVIDER=anthropic
PIWORK_MODEL=claude-sonnet-4-5-20250929
PIWORK_MODEL_BASE_URL=https://api.anthropic.com
PIWORK_API_KEY=CHANGE_ME_ANTHROPIC_API_KEY
