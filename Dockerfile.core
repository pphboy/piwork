# syntax=docker/dockerfile:1
ARG GO_BUILDER_IMAGE=golang:1.25.5-alpine3.22
ARG PIWORK_RUNTIME_IMAGE=alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
FROM node:24-bookworm-slim AS metadata
WORKDIR /source
COPY . .
ARG PIWORK_VERSION
ARG PIWORK_COMMIT
ARG PIWORK_MODIFIED
ARG PIWORK_SOURCE_INPUT_HASH
ARG PIWORK_RELEASE_REGISTRY=docker.io/pphboy
RUN PIWORK_VERSION="$PIWORK_VERSION" PIWORK_COMMIT="$PIWORK_COMMIT" \
    PIWORK_MODIFIED="$PIWORK_MODIFIED" PIWORK_SOURCE_INPUT_HASH="$PIWORK_SOURCE_INPUT_HASH" \
    PIWORK_RELEASE_REGISTRY="$PIWORK_RELEASE_REGISTRY" \
    node scripts/build-docker-release.mjs image /out

FROM ${GO_BUILDER_IMAGE} AS build
ARG GOPROXY=https://proxy.golang.org,direct
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /source
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY internal ./internal
COPY cmd/piwork-serve ./cmd/piwork-serve
COPY --from=metadata /out/core.ldflags /build.ldflags
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    GOOS=linux GOARCH=amd64 go build -mod=readonly -trimpath -buildvcs=false \
      -ldflags="$(cat /build.ldflags)" -o /out/piwork-serve ./cmd/piwork-serve

FROM ${PIWORK_RUNTIME_IMAGE}
RUN apk add --no-cache ca-certificates curl
ARG PIWORK_VERSION
ARG PIWORK_COMMIT
ARG PIWORK_MODIFIED
ARG PIWORK_SOURCE_INPUT_HASH
LABEL org.opencontainers.image.title="piwork-core" \
      org.opencontainers.image.version="${PIWORK_VERSION}" \
      org.opencontainers.image.revision="${PIWORK_COMMIT}" \
      io.piwork.source.modified="${PIWORK_MODIFIED}" \
      io.piwork.source.input-sha256="${PIWORK_SOURCE_INPUT_HASH}"
COPY --from=build --chmod=0555 /out/piwork-serve /usr/local/bin/piwork-serve
COPY --from=metadata --chmod=0444 /out/docker-release.json /etc/piwork/docker-release.json
ENV PIWORK_RELEASE_CONFIG_PATH=/etc/piwork/docker-release.json \
    PIWORK_DATA_DIR=/var/lib/piwork/quickstart/core \
    PIWORK_LISTEN=0.0.0.0:7171 \
    PIWORK_CORE_URL=http://127.0.0.1:7171 \
    PIWORK_AGENT_GRPC_LISTEN=0.0.0.0:7172 \
    PIWORK_AGENT_GRPC_ADVERTISE=piwork-core:7172 \
    DOCKER_HOST=unix:///var/run/docker.sock \
    DOCKER_CONTEXT=""
HEALTHCHECK --interval=5s --timeout=4s --start-period=10s --retries=120 \
    CMD curl --fail --silent --output /dev/null --max-time 3 'http://127.0.0.1:7171/readyz?profile=docker-delivery' || exit 1
ENTRYPOINT ["/usr/local/bin/piwork-serve"]
CMD ["serve", "--allow-insecure-remote"]
