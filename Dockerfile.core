# syntax=docker/dockerfile:1
ARG GO_BUILDER_IMAGE=golang:1.25.5-alpine3.22
ARG PIWORK_RUNTIME_IMAGE=alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
FROM node:24-bookworm-slim AS metadata
WORKDIR /source
COPY . .
ARG PIWORK_VERSION
ARG PIWORK_COMMIT
ARG PIWORK_MODIFIED
ARG PIWORK_SOURCE_INPUT_HASH
ARG PIWORK_DESKTOP_UI_HASH
ARG PIWORK_CONSOLE_UI_HASH
ARG PIWORK_RELEASE_REGISTRY=docker.io/pphboy
RUN PIWORK_VERSION="$PIWORK_VERSION" PIWORK_COMMIT="$PIWORK_COMMIT" \
    PIWORK_MODIFIED="$PIWORK_MODIFIED" PIWORK_SOURCE_INPUT_HASH="$PIWORK_SOURCE_INPUT_HASH" \
    PIWORK_RELEASE_REGISTRY="$PIWORK_RELEASE_REGISTRY" \
    node scripts/build-docker-release.mjs image /out
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts --include-workspace-root -w @piwork/desktop-webui -w @piwork/console-webui \
 && npm run build -w @piwork/desktop-webui -w @piwork/console-webui

FROM ${GO_BUILDER_IMAGE} AS build
ARG GOPROXY=https://proxy.golang.org,direct
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /source
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY internal ./internal
COPY cmd/piwork-core ./cmd/piwork-core
COPY --from=metadata /source/internal/desktopassets/static/ ./internal/desktopassets/static/
COPY --from=metadata /source/internal/consoleassets/static/ ./internal/consoleassets/static/
COPY --from=metadata /out/core.ldflags /build.ldflags
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    GOOS=linux GOARCH=amd64 go build -mod=readonly -trimpath -buildvcs=false \
      -ldflags="$(cat /build.ldflags)" -o /out/piwork-core ./cmd/piwork-core

FROM ${PIWORK_RUNTIME_IMAGE}
RUN apk add --no-cache ca-certificates curl
ARG PIWORK_VERSION
ARG PIWORK_COMMIT
ARG PIWORK_MODIFIED
ARG PIWORK_SOURCE_INPUT_HASH
ARG PIWORK_DESKTOP_UI_HASH
ARG PIWORK_CONSOLE_UI_HASH
LABEL org.opencontainers.image.title="piwork-core" \
      org.opencontainers.image.version="${PIWORK_VERSION}" \
      org.opencontainers.image.revision="${PIWORK_COMMIT}" \
      io.piwork.source.modified="${PIWORK_MODIFIED}" \
      io.piwork.source.input-sha256="${PIWORK_SOURCE_INPUT_HASH}" \
      io.piwork.desktop.input-sha256="${PIWORK_DESKTOP_UI_HASH}" \
      io.piwork.console.input-sha256="${PIWORK_CONSOLE_UI_HASH}"
COPY --from=build --chmod=0555 /out/piwork-core /usr/local/bin/piwork-core
COPY --from=metadata --chmod=0444 /out/docker-release.json /etc/piwork/docker-release.json
ENV DOCKER_HOST=unix:///var/run/docker.sock \
    DOCKER_CONTEXT=""
HEALTHCHECK --interval=5s --timeout=4s --start-period=10s --retries=120 \
    CMD curl --fail --silent --output /dev/null --max-time 3 'http://127.0.0.1:17891/healthz' || exit 1
ENTRYPOINT ["/usr/local/bin/piwork-core"]
CMD ["--data-dir", "/var/lib/piwork/quickstart/core"]
