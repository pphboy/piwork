{
  "name": "@piwork/runtime-docker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test:unit": "npm run build && node --test dist/**/*.test.js",
    "test:integration": "npm run build && node --test dist/**/*.integration.js"
  }
}
