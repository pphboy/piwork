{
  "name": "@piwork/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "types": "./src/index.ts",
    "import": "./dist/index.js"
  },
  "types": "./src/index.ts",
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@grpc/grpc-js": "1.14.5",
    "typebox": "1.3.34"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "proto:gen": "node ../../scripts/generate-protocol.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test:unit": "npm run build && node --test dist/**/*.test.js"
  }
}
