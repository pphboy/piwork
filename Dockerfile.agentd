# syntax=docker/dockerfile:1
ARG GO_BUILDER_IMAGE=golang:1.25.5-alpine3.22
FROM ${GO_BUILDER_IMAGE} AS native-build
ARG GOPROXY=https://proxy.golang.org,direct
ARG PIWORK_COMMIT=unknown
ARG PIWORK_MODIFIED=true
ARG PIWORK_VERSION=0.1.0-dev
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /source
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY internal ./internal
COPY cmd/piwork-service-mcp ./cmd/piwork-service-mcp
COPY cmd/piwork-package-helper ./cmd/piwork-package-helper
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -mod=readonly -trimpath \
      -ldflags "-X piwork/internal/buildinfo.Version=$PIWORK_VERSION -X piwork/internal/buildinfo.Commit=$PIWORK_COMMIT -X piwork/internal/buildinfo.Modified=$PIWORK_MODIFIED" \
      -o /native/ ./cmd/piwork-service-mcp ./cmd/piwork-package-helper

FROM node:24-bookworm-slim AS build
ARG NPM_REGISTRY=https://npmreg.proxy.ustclug.org
WORKDIR /workspace
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/agentd/package.json apps/agentd/tsconfig.json ./apps/agentd/
COPY packages/contracts/package.json packages/contracts/tsconfig.json ./packages/contracts/
COPY packages/work-store/package.json packages/work-store/tsconfig.json ./packages/work-store/
COPY packages/pi-adapter/package.json packages/pi-adapter/tsconfig.json ./packages/pi-adapter/
COPY packages/pi-package/package.json packages/pi-package/tsconfig.json ./packages/pi-package/
RUN --mount=type=cache,target=/root/.npm npm config set registry "$NPM_REGISTRY" \
 && npm config set replace-registry-host always \
 && npm config set fetch-retries 8 \
 && npm config set fetch-retry-mintimeout 1000 \
 && npm config set fetch-retry-maxtimeout 30000 \
 && npm config set fetch-timeout 600000 \
 && for attempt in 1 2 3; do npm ci --ignore-scripts --include-workspace-root \
      -w @piwork/agentd -w @piwork/contracts -w @piwork/work-store \
      -w @piwork/pi-adapter -w @piwork/pi-package && break; test "$attempt" = 3 && exit 1; done
COPY apps/agentd/src ./apps/agentd/src
COPY packages/contracts/src ./packages/contracts/src
COPY proto ./proto
COPY packages/work-store/src ./packages/work-store/src
COPY packages/pi-adapter/src ./packages/pi-adapter/src
COPY packages/pi-package/src ./packages/pi-package/src
RUN npm run build -w @piwork/contracts \
 && npm run build -w @piwork/work-store \
 && npm run build -w @piwork/pi-adapter \
 && npm run build -w @piwork/pi-package \
 && npm run build -w @piwork/agentd \
 && npm prune --omit=dev --include-workspace-root \
      -w @piwork/agentd -w @piwork/contracts -w @piwork/work-store \
      -w @piwork/pi-adapter -w @piwork/pi-package \
 && find /workspace/apps/agentd/dist /workspace/packages/*/dist -type f \
      \( -name '*.test.*' -o -name '*.d.ts' -o -name '*.d.ts.map' -o -name '*.js.map' -o -name '.tsbuildinfo' -o -path '*/testing/*' \) -delete \
 && find /workspace/apps/agentd/dist /workspace/packages/*/dist -depth -type d -empty -delete

FROM node:24-bookworm-slim AS runtime
ARG PIWORK_COMMIT=unknown
ARG PIWORK_MODIFIED=true
ARG PIWORK_VERSION=0.1.0-dev
ARG PIWORK_SOURCE_INPUT_HASH
LABEL org.opencontainers.image.revision="${PIWORK_COMMIT}" \
      org.opencontainers.image.version="${PIWORK_VERSION}" \
      io.piwork.source.modified="${PIWORK_MODIFIED}" \
      io.piwork.source.input-sha256="${PIWORK_SOURCE_INPUT_HASH}"
LABEL io.piwork.agent.protocol="v2" io.piwork.agent.version="0.1.0" \
      io.piwork.package-helper.contract="2" io.piwork.service-mcp.contract="1" \
      io.piwork.work-history.schema="5" io.piwork.run-model.contract="1" io.piwork.work-feedback.contract="1"
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ENV HOME=/var/data \
    PATH=/workspace/node_modules/.bin:$PATH \
    PI_SUBAGENTS_PI_CODING_AGENT_PACKAGE_ROOT=/workspace/node_modules/@earendil-works/pi-coding-agent \
    PI_CODING_AGENT_DIR=/tmp/piwork-child-agent
WORKDIR /workspace
COPY --from=build /workspace/node_modules ./node_modules
COPY --from=build /workspace/apps/agentd/package.json ./apps/agentd/package.json
COPY --from=build /workspace/apps/agentd/dist ./apps/agentd/dist
COPY --from=build /workspace/packages/contracts/package.json ./packages/contracts/package.json
COPY --from=build /workspace/packages/contracts/dist ./packages/contracts/dist
COPY --from=build /workspace/packages/work-store/package.json ./packages/work-store/package.json
COPY --from=build /workspace/packages/work-store/dist ./packages/work-store/dist
COPY --from=build /workspace/packages/pi-adapter/package.json ./packages/pi-adapter/package.json
COPY --from=build /workspace/packages/pi-adapter/dist ./packages/pi-adapter/dist
COPY --from=build /workspace/packages/pi-package/package.json ./packages/pi-package/package.json
COPY --from=build /workspace/packages/pi-package/dist ./packages/pi-package/dist
COPY --from=native-build --chmod=0755 /native/piwork-service-mcp /usr/local/bin/piwork-service-mcp
COPY --from=native-build --chmod=0755 /native/piwork-package-helper /usr/local/bin/piwork-package-helper
RUN mkdir -p /var/data/workspace /workspace/apps/agentd \
 && chown -R 10001:10001 /var/data /workspace/apps/agentd
USER 10001:10001
ENTRYPOINT ["node", "/workspace/apps/agentd/dist/main.js"]

FROM runtime AS production
LABEL io.piwork.agent.variant="production"
ENV PIWORK_AGENT_VARIANT=production

FROM runtime AS acceptance
LABEL io.piwork.agent.variant="acceptance"
ENV PIWORK_AGENT_VARIANT=acceptance
