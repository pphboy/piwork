name: piwork-single-host
# Liveness keeps first-time setup accessible; /readyz tracks runtime preparation.
services:
  core:
    image: @PIWORK_CORE_IMAGE@
    init: true
    user: "0:0"
    network_mode: host
    command: ["serve", "--data-dir", "/var/lib/piwork/examples/single-host/core", "--no-open"]
    volumes:
      - type: bind
        source: /var/run/docker.sock
        target: /var/run/docker.sock
        bind:
          create_host_path: false
      - type: bind
        source: /var/lib/piwork/examples/single-host/core
        target: /var/lib/piwork/examples/single-host/core
        bind:
          create_host_path: true
    stop_grace_period: 60s
    restart: unless-stopped
  cli:
    image: @PIWORK_CLI_IMAGE@
    profiles: [cli]
    init: true
    user: "0:0"
    stdin_open: true
    tty: true
    environment:
      PIWORK_CORE_URL: http://host.docker.internal:7171
    extra_hosts: ["host.docker.internal:host-gateway"]
    volumes:
      - client-state:/var/lib/piwork/client
volumes:
  client-state:
    name: piwork-single-host-client-state
